---
import { icons, type IconName } from '../icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  fill?: string;
  class?: string;
}

const { name, size = 24, strokeWidth = 2, fill = 'none', class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={fill}
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={icons[name]}
/>
