---
import { Picture } from 'astro:assets';
import clinicA from '../assets/clinic-a.jpg';
import clinicB from '../assets/clinic-b.jpg';
import clinicC from '../assets/clinic-c.jpg';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { site, type Lang } from '../data/site';
import { routes, useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const photos = [
  {
    src: clinicA,
    alt:
      lang === 'en'
        ? 'Treatment room at Zmile Dental Clinic in Roma Sur, Mexico City, with dental unit and monitor'
        : 'Consultorio de Zmile Dental Clinic en Roma Sur, CDMX, con unidad dental y monitor',
  },
  {
    src: clinicB,
    alt:
      lang === 'en'
        ? 'Dental chair next to a window overlooking the city at Zmile Dental Clinic'
        : 'Sillón dental junto a un ventanal con vista a la ciudad en Zmile Dental Clinic',
  },
  {
    src: clinicC,
    alt:
      lang === 'en'
        ? 'Zmile Dental Clinic reception with the clinic logo'
        : 'Recepción de Zmile Dental Clinic con el logotipo de la clínica',
  },
];

const stats = [
  { k: site.stats.specialists, v: t('home.stat.specialists') },
  { k: site.stats.specialties, v: t('home.stat.specialties') },
];
---

<section class="relative overflow-hidden">
  <div class="container-luxe pt-16 md:pt-24 pb-20 md:pb-28 compact:pt-9 compact:pb-14 grid lg:grid-cols-12 gap-12 compact:gap-9 items-center">
    <div class="lg:col-span-6 animate-float-in">
      <h1>
        <span class="eyebrow block">{t('home.eyebrow')}</span>
        <span class="mt-6 compact:mt-4 block text-4xl md:text-6xl lg:text-7xl font-light leading-[1.05] tracking-tight">
          {t('home.title1')}{' '}<em class="not-italic text-primary">{t('home.titleEm')}</em>{' '}{t('home.title2')}
        </span>
      </h1>
      <p class="mt-8 compact:mt-[18px] max-w-xl text-lg compact:text-[17px] text-muted-foreground leading-relaxed">{t('home.subtitle')}</p>
      <div class="mt-10 flex flex-wrap gap-3 compact:mt-[26px] compact:grid compact:grid-cols-2 compact:gap-2" data-hero-cta>
        <a
          href={routes.appointment[lang]}
          class="group inline-flex items-center compact:justify-center gap-2 rounded-sm bg-foreground text-background px-7 compact:px-2.5 py-4 text-sm tracking-wide hover:bg-primary transition-colors"
        >
          {t('cta.book')}
          <Icon
            name="arrow-up-right"
            size={16}
            class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
        <WhatsAppButton lang={lang} class="compact:px-2.5" />
      </div>
      <dl class="mt-16 compact:mt-8 grid grid-cols-2 gap-6 max-w-lg">
        {
          stats.map((s) => (
            <div class="flex flex-col-reverse">
              <dt class="mt-1 text-xs uppercase tracking-[0.22em] text-muted-foreground">{s.v}</dt>
              <dd class="text-3xl font-light text-foreground">{s.k}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="lg:col-span-6 animate-fade-in">
      <div class="relative aspect-[4/5] overflow-hidden rounded-sm bg-secondary shadow-luxe" data-carousel>
        {
          photos.map((p, i) => (
            <Picture
              src={p.src}
              alt={p.alt}
              formats={['avif', 'webp']}
              widths={[480, 640, 828, 1200]}
              sizes="(min-width: 1024px) 592px, calc(100vw - 48px)"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding={i === 0 ? 'sync' : 'async'}
              data-slide
              data-active={i === 0 ? '' : undefined}
              class="absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 opacity-0 data-[active]:opacity-100"
            />
          ))
        }
        <div class="absolute top-4 right-4 z-10 flex gap-2">
          {
            photos.map((_, i) => (
              <button
                type="button"
                aria-label={`${t('hero.photo')} ${i + 1}`}
                aria-current={i === 0 ? 'true' : 'false'}
                data-dot
                class="relative h-1.5 w-1.5 rounded-full bg-background/50 transition-all before:absolute before:-inset-3 before:content-[''] aria-[current=true]:w-6 aria-[current=true]:bg-background"
              />
            ))
          }
        </div>
        <div class="absolute inset-x-0 bottom-0 p-6 bg-gradient-to-t from-black/60 to-transparent">
          <p class="text-background/90 text-xs uppercase tracking-[0.3em]">{site.name}</p>
          <p class="text-background text-sm mt-1">{t('home.heroCaption')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Carrusel del hero. Se inicia en cada página (`astro:page-load`) y se detiene antes
  // de cambiar de página o cuando la pestaña no está visible.
  let carousels: { start: () => void; stop: () => void }[] = [];

  document.addEventListener('astro:page-load', () => {
    carousels.forEach((c) => c.stop());
    carousels = [];

    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const slides = root.querySelectorAll<HTMLElement>('[data-slide]');
      const dots = root.querySelectorAll<HTMLElement>('[data-dot]');
      if (slides.length < 2) return;
      let current = 0;
      let timer: number | undefined;

      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((s, i) => s.toggleAttribute('data-active', i === current));
        dots.forEach((d, i) => d.setAttribute('aria-current', String(i === current)));
      };
      const stop = () => window.clearInterval(timer);
      const start = () => {
        stop();
        timer = window.setInterval(() => show(current + 1), 5000);
      };

      dots.forEach((d, i) =>
        d.addEventListener('click', () => {
          show(i);
          start();
        }),
      );
      carousels.push({ start, stop });
      start();
    });
  });
  document.addEventListener('astro:before-swap', () => carousels.forEach((c) => c.stop()));
  document.addEventListener('visibilitychange', () =>
    carousels.forEach((c) => (document.hidden ? c.stop() : c.start())),
  );
</script>
