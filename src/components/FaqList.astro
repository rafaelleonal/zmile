---
import Icon from './Icon.astro';
import type { Faq } from '../data/specialties';

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="border-t border-border">
  {
    faqs.map((f) => (
      <details class="faq group border-b border-border">
        <summary class="flex items-start justify-between gap-6 py-6 compact:py-[18px] text-lg font-normal hover:text-primary transition-colors">
          <h3 class="text-lg font-normal tracking-normal">{f.q}</h3>
          <Icon name="chevron-down" size={18} strokeWidth={1.4} class="faq-chevron mt-1.5 shrink-0 text-primary transition-[rotate] duration-300" />
        </summary>
        <p class="pb-6 pr-10 text-muted-foreground leading-relaxed">{f.a}</p>
      </details>
    ))
  }
</div>
