---
import { Picture } from 'astro:assets';
import photo from '../assets/dra-laura-rojas.jpg';
import Icon from './Icon.astro';
import type { Lang } from '../data/site';
import { director } from '../data/team';
import { routes } from '../i18n/ui';

// Sección "Quiénes somos": presenta a la directora de la clínica con su foto.
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = director[lang];
---

<section class="py-24 md:py-32 compact:py-16" id={lang === 'en' ? 'about' : 'quienes-somos'}>
  <div class="container-luxe grid lg:grid-cols-12 gap-12 compact:gap-9 lg:gap-16 items-center">
    <div class="lg:col-span-5">
      <div class="relative aspect-[4/5] overflow-hidden rounded-sm bg-secondary shadow-luxe">
        <Picture
          src={photo}
          alt={d.photoAlt}
          formats={['avif', 'webp']}
          widths={[420, 640, 828, 1100]}
          sizes="(min-width: 1024px) 480px, calc(100vw - 48px)"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover object-top"
        />
      </div>
    </div>

    <div class="lg:col-span-7">
      <p class="eyebrow">{d.eyebrow}</p>
      <h2 class="mt-4 text-3xl md:text-5xl font-light tracking-tight">{director.name}</h2>
      <p class="mt-3 text-xs uppercase tracking-[0.22em] text-primary">{d.role}</p>
      <p class="mt-8 compact:mt-6 max-w-xl text-lg compact:text-[17px] text-muted-foreground leading-relaxed">{d.lead}</p>
      {d.paragraphs.map((p) => <p class="mt-5 max-w-xl text-muted-foreground leading-relaxed">{p}</p>)}

      <dl class="mt-10 compact:mt-8 max-w-xl border-t border-border">
        {
          d.facts.map((f) => (
            <div class="flex items-baseline justify-between gap-6 border-b border-border py-4">
              <dt class="eyebrow shrink-0">{f.label}</dt>
              <dd class="text-right text-sm">{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-10 compact:mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href={routes.appointment[lang]}
          class="group inline-flex items-center compact:w-full compact:justify-center gap-2 rounded-sm bg-foreground text-background px-7 py-4 text-sm tracking-wide hover:bg-primary transition-colors"
        >
          {d.cta}
          <Icon
            name="arrow-up-right"
            size={16}
            class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
        <a
          href={director.doctoraliaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 compact:py-3 text-xs uppercase tracking-[0.22em] text-muted-foreground hover:text-primary transition-colors"
        >
          {d.reviews}
          <Icon
            name="arrow-up-right"
            size={14}
            class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
      </div>
    </div>
  </div>
</section>
