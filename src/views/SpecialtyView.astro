---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SpecialtyGrid from '../components/SpecialtyGrid.astro';
import FaqList from '../components/FaqList.astro';
import CtaSection from '../components/CtaSection.astro';
import { site, type Lang } from '../data/site';
import { specialtyPath, type Specialty } from '../data/specialties';
import { routes, useT } from '../i18n/ui';
import { breadcrumbSchema, faqSchema, specialtySchema } from '../lib/seo';

interface Props {
  lang: Lang;
  specialty: Specialty;
}

const { lang, specialty: s } = Astro.props;
const t = useT(lang);
const c = s[lang];

const place = lang === 'en' ? 'in Roma Sur, Mexico City' : 'en Roma Sur, CDMX';
const title = `${c.seoName} ${place} | Zmile`;
const description = `${c.short} ${lang === 'en' ? 'Zmile Dental Clinic, Tepic 139, Roma Sur.' : 'Zmile Dental Clinic, Tepic 139, Roma Sur.'}`;

const waMessage =
  lang === 'en'
    ? `Hi, I'd like information about ${c.name} at Zmile Dental Clinic.`
    : `Hola, me gustaría recibir información sobre ${c.name} en Zmile Dental Clinic.`;

const crumbs = [
  { name: t('crumb.home'), path: routes.home[lang] },
  { name: t('nav.specialties'), path: routes.specialties[lang] },
  { name: c.name, path: specialtyPath(s, lang) },
];
---

<Base
  lang={lang}
  title={title}
  description={description}
  alternates={{ es: specialtyPath(s, 'es'), en: specialtyPath(s, 'en') }}
  schema={[specialtySchema(Astro.site!, s, lang), faqSchema(c.faqs), breadcrumbSchema(Astro.site!, crumbs)]}
  heroCta
>
  <article>
    <div class="container-luxe pt-12 md:pt-16 pb-20 md:pb-28 compact:pt-7 compact:pb-14">
      <nav aria-label="Breadcrumb">
        <ol class="eyebrow flex flex-wrap items-center gap-x-3 gap-y-1">
          {
            crumbs.map((crumb, i) => (
              <li class:list={['flex items-center gap-3', i === 0 && 'compact:hidden']}>
                {i > 0 && <span aria-hidden="true" class:list={[i === 1 && 'compact:hidden']}>/</span>}
                {i < crumbs.length - 1 ? (
                  <a href={crumb.path} class="hover:text-primary transition-colors">
                    {crumb.name}
                  </a>
                ) : (
                  <span aria-current="page" class="text-foreground">
                    {crumb.name}
                  </span>
                )}
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="mt-12 md:mt-16 compact:mt-7 grid lg:grid-cols-12 gap-12 compact:gap-9 lg:gap-16">
        <div class="lg:col-span-7 animate-float-in">
          <span class="h-12 w-12 rounded-sm border border-border grid place-items-center text-primary">
            <Icon name={s.icon} size={20} strokeWidth={1.4} />
          </span>
          <h1 class="mt-8 text-4xl md:text-6xl font-light leading-[1.05] tracking-tight">
            {c.name}{' '}<em class="not-italic text-primary">{place}</em>
          </h1>
          <p class="mt-8 max-w-xl text-lg text-muted-foreground leading-relaxed">{c.short}</p>
          <p class="mt-6 max-w-xl text-muted-foreground leading-relaxed">{c.intro}</p>
          <div class="mt-10 flex flex-wrap gap-3 compact:mt-[26px] compact:grid compact:grid-cols-2 compact:gap-2" data-hero-cta>
            <a
              href={`${routes.appointment[lang]}?s=${s.id}`}
              class="group inline-flex items-center compact:justify-center gap-2 rounded-sm bg-foreground text-background px-7 compact:px-2.5 py-4 text-sm tracking-wide hover:bg-primary transition-colors"
            >
              {t('cta.book')}
              <Icon
                name="arrow-up-right"
                size={16}
                class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            </a>
            <WhatsAppButton lang={lang} message={waMessage} class="compact:px-2.5" />
          </div>
        </div>

        <aside class="lg:col-span-5 animate-fade-in">
          <div class="border border-border bg-secondary/40 p-8 md:p-10 compact:p-6">
            <h2 class="eyebrow">{t('spec.includes')}</h2>
            <ul class="mt-6">
              {
                c.treats.map((item) => (
                  <li class="flex items-start gap-4 border-t border-border py-4 first:border-t-0 first:pt-0 last:pb-0">
                    <Icon name="check" size={16} strokeWidth={1.4} class="mt-1 shrink-0 text-primary" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
            <div class="mt-8 border-t border-border pt-6 space-y-2 text-sm text-muted-foreground">
              <p>{site.address.display[lang]}</p>
              <p>{site.hours.display[lang]}</p>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <section class="py-24 md:py-32 compact:py-16 bg-secondary/40">
      <div class="container-luxe">
        <div class="max-w-2xl mx-auto text-center mb-16 compact:mb-9">
          <p class="eyebrow">{c.name}</p>
          <h2 class="mt-4 text-3xl md:text-5xl font-light tracking-tight">{t('spec.faqTitle')}</h2>
        </div>
        <div class="max-w-3xl mx-auto">
          <FaqList faqs={c.faqs} />
        </div>
      </div>
    </section>
  </article>

  <section class="py-24 md:py-32 compact:py-16">
    <div class="container-luxe">
      <div class="mb-16 compact:mb-9">
        <p class="eyebrow">{t('nav.specialties')}</p>
        <h2 class="mt-4 text-3xl md:text-5xl font-light tracking-tight">{t('spec.others')}</h2>
      </div>
      <SpecialtyGrid lang={lang} dialogs={false} exclude={s.id} />
    </div>
  </section>

  <CtaSection lang={lang} title={`${t('spec.cta.title')} ${c.name}.`} specialty={s.id} />
</Base>
