---
import Base from '../layouts/Base.astro';
import SpecialtyGrid from '../components/SpecialtyGrid.astro';
import CtaSection from '../components/CtaSection.astro';
import type { Lang } from '../data/site';
import { routes, useT } from '../i18n/ui';
import { breadcrumbSchema } from '../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const meta = {
  es: {
    title: 'Especialidades dentales en Roma Sur, CDMX | Zmile Dental Clinic',
    description:
      'Ortodoncia, implantes dentales, endodoncia, periodoncia, odontopediatría, estética dental y más: nueve especialidades en un mismo lugar en Roma Sur, Ciudad de México.',
  },
  en: {
    title: 'Dental specialties in Roma Sur, Mexico City | Zmile Dental Clinic',
    description:
      'Orthodontics, dental implants, root canals, periodontics, pediatric and cosmetic dentistry and more: nine specialties in one place in Roma Sur, Mexico City.',
  },
}[lang];
---

<Base
  lang={lang}
  title={meta.title}
  description={meta.description}
  alternates={routes.specialties}
  schema={[
    breadcrumbSchema(Astro.site!, [
      { name: t('crumb.home'), path: routes.home[lang] },
      { name: t('nav.specialties'), path: routes.specialties[lang] },
    ]),
  ]}
>
  <div class="container-luxe pt-20 md:pt-28 pb-24 md:pb-32 compact:pt-11 compact:pb-16">
    <div class="grid md:grid-cols-12 gap-10 compact:gap-3.5 items-end mb-16 compact:mb-9">
      <div class="md:col-span-7">
        <p class="eyebrow">{t('spec.eyebrow')}</p>
        <h1 class="mt-4 text-4xl md:text-6xl font-light tracking-tight">{t('spec.title')}</h1>
      </div>
      <div class="md:col-span-5">
        <p class="text-muted-foreground leading-relaxed">{t('spec.indexIntro')}</p>
      </div>
    </div>
    <SpecialtyGrid lang={lang} dialogs={false} headingLevel="h2" />
  </div>

  <CtaSection lang={lang} />
</Base>
