---
import SpecialtyView from '../../../views/SpecialtyView.astro';
import { specialties } from '../../../data/specialties';

export function getStaticPaths() {
  return specialties.map((specialty) => ({ params: { slug: specialty.en.slug }, props: { specialty } }));
}

const { specialty } = Astro.props;
---

<SpecialtyView lang="en" specialty={specialty} />
