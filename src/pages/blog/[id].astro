---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import directorPhoto from '../../assets/dra-laura-rojas.jpg';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import CtaSection from '../../components/CtaSection.astro';
import { site } from '../../data/site';
import { director } from '../../data/team';
import { routes } from '../../i18n/ui';
import { blogPath, formatDate, getPosts, postPath, readingMinutes, type Post } from '../../lib/blog';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, more: posts.filter((p) => p.id !== post.id).slice(0, 3) },
  }));
}

interface Props {
  post: Post;
  more: Post[];
}

const { post, more } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, author, cover, coverAlt, draft } = post.data;
const byDirector = author === director.name;

const crumbs = [
  { name: 'Inicio', path: routes.home.es },
  { name: 'Blog', path: blogPath },
  { name: title, path: postPath(post) },
];
---

<Base
  lang="es"
  title={`${title} | Zmile Dental Clinic`}
  description={description}
  alternates={{ es: postPath(post), en: routes.home.en }}
  translated={false}
  active="blog"
  noindex={draft}
  schema={[articleSchema(Astro.site!, post), breadcrumbSchema(Astro.site!, crumbs)]}
>
  <article>
    <header class="container-luxe pt-12 md:pt-16 compact:pt-7">
      <nav aria-label="Breadcrumb">
        <ol class="eyebrow flex flex-wrap items-center gap-x-3 gap-y-1">
          <li class="compact:hidden"><a href={routes.home.es} class="hover:text-primary transition-colors">Inicio</a></li>
          <li class="flex items-center gap-3">
            <span aria-hidden="true" class="compact:hidden">/</span>
            <a href={blogPath} class="hover:text-primary transition-colors">Blog</a>
          </li>
        </ol>
      </nav>

      <div class="mt-10 md:mt-14 compact:mt-7 max-w-4xl animate-float-in">
        <p class="eyebrow">
          <time datetime={pubDate.toISOString().slice(0, 10)}>{formatDate(pubDate)}</time>
          <span> · {readingMinutes(post)} min de lectura</span>
          {draft && <span class="text-primary"> · Borrador</span>}
        </p>
        <h1 class="mt-5 text-4xl md:text-6xl font-light leading-[1.05] tracking-tight">{title}</h1>
        <p class="mt-6 max-w-2xl text-lg compact:text-[17px] text-muted-foreground leading-relaxed">{description}</p>
      </div>
    </header>

    {
      cover && (
        <div class="container-luxe mt-10 md:mt-14 compact:mt-8 animate-fade-in">
          <div class="overflow-hidden rounded-sm bg-secondary shadow-luxe">
            <img
              src={cover}
              alt={coverAlt ?? ''}
              decoding="async"
              class="aspect-[3/2] md:aspect-[21/9] w-full object-cover object-[center_30%]"
            />
          </div>
        </div>
      )
    }

    <div class="container-luxe mt-12 md:mt-16 compact:mt-9 pb-20 md:pb-28 compact:pb-14 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="prose-zmile lg:col-span-8">
        <Content />
      </div>

      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-28 space-y-6">
          <div class="border border-border p-6">
            <p class="eyebrow">Escrito por</p>
            <div class="mt-4 flex items-center gap-4">
              {
                byDirector && (
                  <Image
                    src={directorPhoto}
                    alt=""
                    width={128}
                    height={128}
                    fit="cover"
                    position="top"
                    class="h-16 w-16 shrink-0 rounded-full object-cover"
                  />
                )
              }
              <div>
                <p class="text-lg leading-tight">{author}</p>
                <p class="mt-1 text-sm text-muted-foreground">{byDirector ? director.es.jobTitle : site.address.display.es}</p>
              </div>
            </div>
            {
              byDirector && (
                <a
                  href="/#quienes-somos"
                  class="group mt-5 inline-flex items-center gap-1 text-xs uppercase tracking-[0.22em] text-muted-foreground hover:text-primary transition-colors"
                >
                  Conócela
                  <Icon
                    name="arrow-up-right"
                    size={12}
                    class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </a>
              )
            }
          </div>

          <div class="border border-border bg-secondary/40 p-6">
            <p class="eyebrow">Agenda</p>
            <p class="mt-3 text-xl font-light leading-snug tracking-tight">¿Tienes dudas sobre tu caso?</p>
            <p class="mt-3 text-sm text-muted-foreground leading-relaxed">
              Lo revisamos en una valoración en {site.address.neighborhood}, de {site.hours.long.es}.
            </p>
            <div class="mt-5 grid gap-2">
              <a
                href={routes.appointment.es}
                class="group inline-flex items-center justify-center gap-2 rounded-sm bg-foreground text-background px-7 py-4 text-sm tracking-wide hover:bg-primary transition-colors"
              >
                Agenda tu cita
                <Icon
                  name="arrow-up-right"
                  size={16}
                  class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </a>
              <WhatsAppButton lang="es" />
            </div>
          </div>
        </div>
      </aside>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="py-24 md:py-32 compact:py-16 bg-secondary/40">
        <div class="container-luxe">
          <div class="mb-16 compact:mb-9">
            <p class="eyebrow">Blog</p>
            <h2 class="mt-4 text-3xl md:text-5xl font-light tracking-tight">Sigue leyendo</h2>
          </div>
          <div class="grid gap-x-10 gap-y-14 compact:gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {more.map((p) => <PostCard post={p} headingLevel="h3" />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaSection lang="es" />
</Base>
